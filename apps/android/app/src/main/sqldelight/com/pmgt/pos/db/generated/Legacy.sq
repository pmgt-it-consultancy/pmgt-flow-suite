-- Generated logical declarations ONLY; LegacySqlSchema owns physical DDL.
CREATE TABLE local_storage (key TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE "categories" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "name" TEXT, "parent_id" TEXT, "sort_order" REAL, "is_active" INTEGER, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "products" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "name" TEXT, "category_id" TEXT, "price" REAL, "is_vatable" INTEGER, "is_active" INTEGER, "is_open_price" INTEGER, "min_price" REAL, "max_price" REAL, "sort_order" REAL, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "modifier_groups" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "name" TEXT, "selection_type" TEXT, "min_selections" REAL, "max_selections" REAL, "sort_order" REAL, "is_active" INTEGER, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "modifier_options" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "modifier_group_id" TEXT, "name" TEXT, "price_adjustment" REAL, "is_default" INTEGER, "is_available" INTEGER, "sort_order" REAL, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "modifier_group_assignments" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "modifier_group_id" TEXT, "product_id" TEXT, "category_id" TEXT, "sort_order" REAL, "min_selections_override" REAL, "max_selections_override" REAL, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "tables" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "name" TEXT, "capacity" REAL, "status" TEXT, "current_order_id" TEXT, "sort_order" REAL, "is_active" INTEGER, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "orders" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "order_number" TEXT, "order_type" TEXT, "order_channel" TEXT, "takeout_status" TEXT, "table_id" TEXT, "customer_name" TEXT, "draft_label" TEXT, "status" TEXT, "gross_sales" REAL, "vatable_sales" REAL, "vat_amount" REAL, "vat_exempt_sales" REAL, "non_vat_sales" REAL, "discount_amount" REAL, "net_sales" REAL, "payment_method" TEXT, "cash_received" REAL, "change_given" REAL, "card_payment_type" TEXT, "card_reference_number" TEXT, "order_category" TEXT, "table_marker" TEXT, "created_by" TEXT, "created_at" REAL, "paid_at" REAL, "paid_by" TEXT, "pax" REAL, "tab_number" REAL, "tab_name" TEXT, "request_id" TEXT, "table_name" TEXT, "item_count" REAL, "origin_device_id" TEXT, "refunded_from_order_id" TEXT, "updated_at" REAL);
CREATE TABLE "order_items" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "order_id" TEXT, "product_id" TEXT, "product_name" TEXT, "product_price" REAL, "quantity" REAL, "notes" TEXT, "service_type" TEXT, "is_voided" INTEGER, "is_sent_to_kitchen" INTEGER, "voided_by" TEXT, "voided_at" REAL, "void_reason" TEXT, "updated_at" REAL);
CREATE TABLE "order_item_modifiers" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "order_item_id" TEXT, "modifier_group_name" TEXT, "modifier_option_name" TEXT, "price_adjustment" REAL, "updated_at" REAL);
CREATE TABLE "order_discounts" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "order_id" TEXT, "order_item_id" TEXT, "discount_type" TEXT, "customer_name" TEXT, "customer_id" TEXT, "quantity_applied" REAL, "discount_amount" REAL, "vat_exempt_amount" REAL, "approved_by" TEXT, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "order_voids" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "order_id" TEXT, "void_type" TEXT, "order_item_id" TEXT, "reason" TEXT, "approved_by" TEXT, "requested_by" TEXT, "amount" REAL, "created_at" REAL, "refund_method" TEXT, "replacement_order_id" TEXT, "updated_at" REAL);
CREATE TABLE "order_payments" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "order_id" TEXT, "store_id" TEXT, "payment_method" TEXT, "amount" REAL, "cash_received" REAL, "change_given" REAL, "card_payment_type" TEXT, "card_reference_number" TEXT, "created_at" REAL, "created_by" TEXT, "updated_at" REAL);
CREATE TABLE "users" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "name" TEXT, "email" TEXT, "role_id" TEXT, "store_id" TEXT, "pin" TEXT, "is_active" INTEGER, "updated_at" REAL);
CREATE TABLE "roles" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "name" TEXT, "permissions" TEXT, "scope_level" TEXT, "is_system" INTEGER, "updated_at" REAL);
CREATE TABLE "stores" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "name" TEXT, "parent_id" TEXT, "logo" TEXT, "address1" TEXT, "address2" TEXT, "tin" TEXT, "min" TEXT, "vat_rate" REAL, "printer_mac" TEXT, "kitchen_printer_mac" TEXT, "contact_number" TEXT, "telephone" TEXT, "email" TEXT, "website" TEXT, "footer" TEXT, "schedule_json" TEXT, "is_active" INTEGER, "created_at" REAL, "device_code_counter" REAL, "updated_at" REAL);
CREATE TABLE "settings" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "key" TEXT, "value" TEXT, "updated_at" REAL);
CREATE TABLE "app_config" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "key" TEXT, "value" TEXT, "store_id" TEXT, "updated_at" REAL);
CREATE TABLE "audit_logs" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "server_id" TEXT, "store_id" TEXT, "action" TEXT, "entity_type" TEXT, "entity_id" TEXT, "details" TEXT, "user_id" TEXT, "created_at" REAL, "updated_at" REAL);
CREATE TABLE "sync_meta" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "key" TEXT, "value" TEXT);
CREATE TABLE "sync_v2_aggregates" (id TEXT PRIMARY KEY, _changed TEXT, _status TEXT, "store_id" TEXT, "order_id" TEXT, "aggregate_version" REAL, "payload" TEXT, "updated_at" REAL);

readLocalValue:
SELECT value FROM local_storage WHERE key = ?;
